/// Liquid — entry point for the liquid template engine.
///
///     (Liquid parse: source) andThen: [:t | t render: vars]
///
/// `parse:` returns `Result(Template, LiquidError)`; `Template render:`
/// returns `Result(String, LiquidError)`. See the README for the supported
/// subset and the divergences from Liquid.
typed Object subclass: Liquid

  /// Package version.
  class version -> String => "0.1.0"

  /// Parse a template. All lex and parse errors are collected: the
  /// returned LiquidError describes the first (by position) and
  /// `errors` lists them all.
  class parse: source :: String -> Result =>
    {segs, lexErrs} := Lexer tokenize: source
    {nodes, parseErrs} := Parser parseAll: segs
    errs := (lexErrs ++ parseErrs)
      sort: [:a :: LiquidError :b :: LiquidError |
        a line < b line or: [a line =:= b line and: [a column <= b column]]
      ]
    errs isEmpty ifTrue: [
      Result ok: (Template new: #{#nodes => nodes})
    ] ifFalse: [Result error: (LiquidError fromList: errs)]
