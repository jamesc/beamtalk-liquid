/// OutputNode — `{{ expr | filters }}`.
///
/// The value is converted to text and emitted as is. It is never scanned
/// again for template markup.
typed AstNode subclass: OutputNode
  field: expr :: Expr = Literal new

  render: scope :: Scope -> Tuple =>
    {value, errs} := self.expr eval: scope
    {Renderer stringify: value, errs}
