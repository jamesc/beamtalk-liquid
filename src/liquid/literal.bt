/// Literal — a constant expression: string, number, `true`, `false`, `nil`.
typed Expr subclass: Literal
  field: value :: Object | Nil = nil

  /// Evaluate: `{value, errors}`.
  eval: _scope :: Scope -> Tuple => {self.value, #()}
