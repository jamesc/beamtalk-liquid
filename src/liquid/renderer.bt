/// Renderer — shared rendering helpers: node lists, truthiness, lookup and
/// value-to-text conversion.
typed Object subclass: Renderer

  /// Render nodes in order. Returns `{text, errors}`.
  class renderAll: nodes :: List scope: scope :: Scope -> Tuple =>
    pieces := #()
    errChunks := #()
    nodes
      do: [:node :: AstNode |
        {text, nodeErrs} := node render: scope
        pieces := pieces addFirst: text
        nodeErrs isEmpty ifFalse: [errChunks := errChunks addFirst: nodeErrs]
      ]
    {pieces reversed join, errChunks reversed flatten}

  /// Only `nil` and `false` are falsy (`0`, `""` and `#()` are truthy).
  class truthy: value :: Object | Nil -> Boolean =>
    (value isNil) not and: [(value =:= false) not]

  /// Convert a value to output text. `nil` is empty; lists concatenate
  /// their elements; maps use their printString.
  class stringify: value :: Object | Nil -> String =>
    value match: [
      nil -> "";
      s :: String -> s;
      items :: List -> items inject: "" into: [:acc :: String :each :: Object |
        acc ++ (self stringify: each)
      ];
      _ -> value displayString
    ]

  /// One step of a path lookup. Returns `{found, value}`.
  ///
  /// Maps are keyed by strings. Lists take integer indexes (0-based,
  /// negative counts from the end). `size` works on lists, maps (when there
  /// is no `size` key) and strings; `first` / `last` work on lists.
  class lookup: container :: Object | Nil key: key :: Object | Nil -> Tuple =>
    container match: [
      map :: Dictionary -> self lookupMap: map key: key;
      items :: List -> self lookupList: items key: key;
      text :: String -> key =:= "size" ifTrue: [
        {true, text length}
      ] ifFalse: [{false, nil}];
      _ -> {false, nil}
    ]

  /// Map step of `lookup:key:`: string keys, plus `size` when absent.
  class lookupMap: map :: Dictionary key: key :: Object | Nil -> Tuple =>
    (key isKindOf: String) ifFalse: [^{false, nil}]
    (map includesKey: key) ifTrue: [^{true, map at: key}]
    key =:= "size" ifTrue: [^{true, map size}]
    {false, nil}

  /// List step of `lookup:key:`: integer index, `size`, `first`, `last`.
  class lookupList: items :: List key: key :: Object | Nil -> Tuple =>
    key match: [
      idx :: Integer -> self lookupIndex: items at: idx;
      "size" -> {true, items size};
      "first" -> {true, items isEmpty ifTrue: [nil] ifFalse: [items first]};
      "last" -> {true, items isEmpty ifTrue: [nil] ifFalse: [items last]};
      _ -> {false, nil}
    ]

  /// 0-based list index; negative counts from the end.
  class lookupIndex: items :: List at: key :: Integer -> Tuple =>
    n := items size
    idx := key < 0 ifTrue: [n + key] ifFalse: [key]
    (idx >= 0 and: [idx < n]) ifTrue: [^{true, items at: idx + 1}]
    {false, nil}
